# VibeCut 环境变量配置
# 复制本文件为 .env，填入真实值后运行项目.1

# ── LLM ──────────────────────────────────────────────────────────────────────
# OpenAI API Key（必填，用于驱动 GPT-4o 规划剧本）
OPENAI_API_KEY=

# ── 视频生成 API（可选）──────────────────────────────────────────────────────
# 阿里百炼 API Key（与 OPENAI_API_KEY 相同，使用同一个 Key）
# 若不填写，系统将自动用 ffmpeg 生成蓝色占位视频（Mock 模式）
DASHSCOPE_API_KEY=

# ── VM 连接（本地运行时保持默认即可）────────────────────────────────────────
# Mock VM 服务器地址与端口（与 vm_server.py 保持一致）
VIBECUT_VM_HOST=localhost
VIBECUT_VM_PORT=8765

# VM 内部工作目录（vm_server.py 存放上传文件和生成产物的路径）
VIBECUT_VM_WORKSPACE=/tmp/vibecut

# VM 内 Python 解释器路径（通常无需修改）
VIBECUT_VM_PYTHON=python3

# editor_script.py 在 VM 内的路径（vm_server.py 会自动把脚本复制过去）
# 若使用本地 vm_server.py，路径即为本项目的 editor_script.py 绝对路径
VIBECUT_EDITOR_SCRIPT_PATH=/tmp/vibecut/editor_script.py
